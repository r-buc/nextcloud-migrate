{
    "name": "nextcloud/nextcloud_migrate",
    "description": "Migrate a user's files 1:1 to a remote Nextcloud instance",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.1",
        "psr/log": "^2.0|^3.0",
        "symfony/uid": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OCA\\NextcloudMigrate\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit"
    }
}
